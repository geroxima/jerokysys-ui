# Datos fiscales del emisor que se muestran en la hoja de factura
ISSUER_NAME=JerokySys
ISSUER_RUC=80000000-0
ISSUER_ADDRESS=Av. Ejemplo 123, Asunción
ISSUER_PHONE=+595 21 000 000

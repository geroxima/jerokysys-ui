# URL base de la API para el navegador (cliente) y para el login server-side.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
# Opcional: si el login server-side debe usar otra URL, definí API_BASE_URL.
# API_BASE_URL=http://localhost:8080/api/v1

# Datos fiscales del emisor que se muestran en la hoja de factura.
# Son públicos: se incluyen en el bundle del cliente.
NEXT_PUBLIC_ISSUER_NAME=JerokySys
NEXT_PUBLIC_ISSUER_RUC=80000000-0
NEXT_PUBLIC_ISSUER_ADDRESS=Av. Ejemplo 123, Asunción
NEXT_PUBLIC_ISSUER_PHONE=+595 21 000 000
NEXT_PUBLIC_ISSUER_EMAIL=facturacion@jerokysys.example
NEXT_PUBLIC_ISSUER_ACTIVITY=Enseñanza de danza

# Timbrados habilitados. El número se calcula como timbrado-serie-correlativo.
# Cada timbrado puede tener su propia dirección; si se omite, se usa ISSUER_ADDRESS.
NEXT_PUBLIC_INVOICE_TIMBRADOS=[{"timbrado":"001","serie":"001","label":"Casa central"},{"timbrado":"002","serie":"001","label":"Sucursal","address":"Av. Ejemplo 456, Asunción"}]

# Producción: dominio compartido de la cookie cuando UI y API viven en
# subdominios distintos (ej. .jerokysys.com). En localhost debe quedar vacío.
# AUTH_COOKIE_DOMAIN=.jerokysys.com
